flowchart TB
    A["Request<br/>Route + acceptance"]
    B["Explore<br/>Read-only context"]
    C["Plan<br/>Task graph"]
    D{"Plan approved?"}

    E["Report<br/>No mutation"]
    F["Green baseline"]
    G["Scoped test/build"]
    H["Verify workspace"]
    I{"Review approved?"}

    J["Docs + final checks"]
    K["Validate + sync"]
    L["Builder fixes"]
    M["Stop safely"]

    A --> B --> C --> D
    D -->|Read-only| E
    D -->|Mutation| F
    F --> G --> H --> I
    I -->|Yes| J --> K
    I -->|Changes| L --> G
    I -->|Limit| M

    classDef normal fill:#161b22,stroke:#2f61ff,color:#fff
    classDef green fill:#162014,stroke:#7ee000,color:#fff
    classDef cyan fill:#10272a,stroke:#00cddd,color:#fff

    class A,B,C,D,E,I,J,M normal
    class F,H,K green
    class G,L cyan
